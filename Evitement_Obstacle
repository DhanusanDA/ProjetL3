//Fonction pour arreter le robot
void arreter()
{
  //On arrete les deux moteurs 
  piloterMoteur(MOTEUR_A, ARRET, 0 ); 
  piloterMoteur(MOTEUR_B, ARRET, 0);
}


//-------------------------------------------------
//Fonction d'évitement d'obstacle
//-------------------------------------------------

EvitementObstacle(int i)
{
  
  //Premier évitement d'obstacle
  if(i==1)
  {
    myservo.write(0);
    while(DistanceObstacle!=10)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      tournerDroite(25, 25);
    }
    while(DistanceObstacle<=50)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      avancer()
    }
    while(DistanceObstacle!=10)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      tournerGauche(25, 25);
    }
    while(DistanceObstacle<=50)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      avancer()
    }
    while((recuperationLigne()!=1)
    {
      tournerGauche(28,45);
    }

    
  }
  //Deuxième évitement d'obstacle 
  else if(i==2)
  {
    myservo.write(180);
    while(DistanceObstacle!=10)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      tournerGauche(25, 25);
    }
    while(DistanceObstacle<=50)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      avancer()
    }
    while(DistanceObstacle!=10)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      tournerDroite(25, 25);
    }
    while(DistanceObstacle<=50)
    {
      DistanceObstacle = ultrasonic.MeasureInCentimeters();
      avancer()
    }
    while((recuperationLigne()!=1)
    {
      tournerDroite(28,45);
    }
  }
}
//-------------------------------------------------
//Fonction de recuperation de ligne
//-------------------------------------------------
int recuperationLigne()
{
  while (1)
  {
    pos = LightSensorRGB_1.getPositionState();
    if(pos == 0b1100 || pos == 0b1110 || pos == 0b1000 || pos == 1101 || pos == 0b1001 || pos == 0b0001 || pos == 0b0011 || pos == 0b0111 || pos == 1011)
    {
      return(1)
    }
  }
}

